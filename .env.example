# OPENAI_API_KEY: Optional OpenAI key. Put the real value in .env only.
OPENAI_API_KEY=""

# GEMINI_API_KEY: Required for Gemini AI API calls.
# this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
#  the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Voice Cloning System Configuration
MAX_UPLOAD_SIZE_MB=15.0
MIN_AUDIO_DURATION_SEC=3.0
MAX_AUDIO_DURATION_SEC=30.0
MAX_TEXT_LENGTH=1000
OUTPUT_RETENTION_HOURS=24
TARGET_SAMPLE_RATE=16000
DEVICE=auto
LOG_LEVEL=INFO
